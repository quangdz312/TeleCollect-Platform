# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- App Identity ----
# Tên ứng dụng, hiện trong log khởi động và tiêu đề OpenAPI
APP_NAME=TeleCollect

# ---- Database ----
# Connection string tới DB lưu metadata episode, nhãn demo và tài khoản/vai trò.
# Mặc định SQLite + driver async aiosqlite (đã có trong requirements.txt).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# For PostgreSQL (production) — nhớ thêm asyncpg vào requirements.txt:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/telecollect

# ---- Storage ----
# Thư mục gốc chứa artifact episode. Cấu trúc con cố định, tự tạo bên dưới:
#   <STORAGE_DIR>/episodes/<id>/{front.mp4, wrist.mp4, trajectory.json, thumb.jpg}
#   <STORAGE_DIR>/tmp/<id>/          (thư mục tạm lúc validate upload)
#   <STORAGE_DIR>/datasets/<id>.zip  (dataset đã đóng gói)
STORAGE_DIR=./data

# Workspace cho scripted collection + human labeling
REVIEW_DIR=./data/review

# Giới hạn dung lượng mỗi file upload (front/wrist/trajectory), tính bằng MB
MAX_UPLOAD_MB=200

# ---- Teleop ----
# Tần số vòng điều khiển (Hz) — chu kỳ gửi action và lấy mẫu observation
CONTROL_HZ=60
# Số phiên teleop chạy đồng thời tối đa (mỗi phiên chiếm một instance sim)
MAX_CONCURRENT_SESSIONS=4
# Trần số bước một episode web; 0 = không giới hạn
MAX_RECORD_STEPS=0
# Input cũ hơn ngưỡng này bị coi là stale -> robot nhận neutral motion
COMMAND_TIMEOUT_MS=250
# Grace period khi browser rớt giữa lúc ghi
RECONNECT_GRACE_S=10
# Phiên idle mất controller quá lâu sẽ bị đóng
SESSION_IDLE_TIMEOUT_S=300
# Nhịp gửi observation/stats JSON và frame JPEG về browser
TELEMETRY_HZ=15
STREAM_FPS=30
SECONDARY_STREAM_FPS=10
JPEG_QUALITY=75

# ---- Camera ----
# Ba camera, theo đúng thứ tự frontend giải mã (xem CAMERA_BY_INDEX trong
# frontend/lib/real-teleop.ts): góc review chính, nhìn từ trên xuống, rồi cổ tay.
#
# Ba dòng dưới trùng với mặc định trong src/config.py và có mặt ở đây để nói rõ
# rằng phải có ĐỦ BA. Bản trước chỉ khai secondary và bỏ tertiary, nên tertiary
# rơi về mặc định trùng luôn với secondary và hai khung phụ hiển thị y hệt nhau
# — máy nào copy file này thành .env đều gặp, máy nào không có mấy dòng này thì
# không, nên lỗi trông như chỉ xảy ra với một người.
#
# `review_front` không phải camera có sẵn của robosuite: src/sim/review_camera.py
# lắp nó vào model lúc dựng env, vì `frontview` của ToolHang bị bàn che hết.
TELEOP_CAMERAS=review_front,birdview,robot0_eye_in_hand
PREVIEW_CAMERA=review_front
PREVIEW_CAMERA_SECONDARY=birdview
PREVIEW_CAMERA_TERTIARY=robot0_eye_in_hand
PREVIEW_SIZE=640

# ---- Security ----
# Khoá ký JWT cho ba vai trò operator / reviewer / admin — BẮT BUỘC đặt ở production
JWT_SECRET=change-me-in-production
# Thời hạn access token (phút) / refresh token (ngày)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Bật/tắt POST /auth/register — luôn tạo role operator, không bao giờ tạo admin
ALLOW_SELF_REGISTER=true
# Cho phép reviewer tự duyệt (approve/reject) demo do chính mình upload.
# Mặc định false — chỉ bật khi cần demo bằng một tài khoản duy nhất.
ALLOW_SELF_REVIEW=false

# ---- Data Privacy ----
# Bật ẩn danh khuôn mặt trước khi lưu trữ lâu dài (ràng buộc dự án)
ENABLE_FACE_ANONYMIZATION=true

# ---- App Config ----
# Môi trường chạy: development | production | test
APP_ENV=development
# Cổng HTTP/WebSocket của FastAPI backend
APP_PORT=8000
# Địa chỉ bind của server (0.0.0.0 = nhận kết nối từ mọi interface, cần cho Docker)
APP_HOST=0.0.0.0
# Danh sách origin frontend được phép gọi API/WebSocket, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Logging ----
# Mức log của ứng dụng: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
# Endpoint grading server nhận AI usage log (giữ nguyên, do BTC cung cấp)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# Key riêng của đội — thay bằng key từ link mời của BTC (giá trị dưới chỉ là placeholder)
AI_LOG_API_KEY=your-team-ai-log-key-here
# Thư mục local chứa session.jsonl trước khi submit lên server
AI_LOG_DIR=.ai-log

# ---- Training runner ----
# Nơi chạy training job: local | runpod
#   local  — subprocess trên chính máy chạy backend (mặc định, cho máy dev có GPU)
#   runpod — thuê GPU theo giây qua RunPod Serverless (cho server không GPU)
TRAINING_RUNNER=local
# Khóa RunPod (Settings -> API Keys, quyền Read/Write). BÍ MẬT, không commit.
RUNPOD_API_KEY=
# Endpoint Serverless đã trỏ tới image train của dự án
RUNPOD_ENDPOINT_ID=
# Nhịp hỏi trạng thái job, tính bằng giây; mỗi lần hỏi là một request tính phí
RUNPOD_POLL_INTERVAL_S=10
# Trần thời gian một job chạy trên GPU thuê — chặn hóa đơn khi job treo
RUNPOD_MAX_HOURS=1
# URL server nhìn từ internet, để máy GPU thuê tải dataset và đẩy checkpoint về.
# Bắt buộc khi TRAINING_RUNNER=runpod; localhost không dùng được vì máy thuê ở mạng khác.
PUBLIC_BASE_URL=
# Khóa ký token máy. Rỗng thì dùng chung JWT_SECRET. BÍ MẬT, không commit.
MACHINE_TOKEN_SECRET=

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000   # Base URL backend cho Next.js gọi REST/WebSocket
