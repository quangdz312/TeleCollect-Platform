# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# API key OpenAI — dùng cho LLM service của agent
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=      # API key Anthropic (Claude), nếu đổi provider
# GOOGLE_API_KEY=         # API key Google AI Studio (Gemini), nếu đổi provider

# ---- Database ----
# Connection string tới DB lưu metadata episode, nhãn demo và tài khoản/vai trò
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
# Thư mục ChromaDB persist embeddings trên đĩa (tạo tự động nếu chưa có)
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=       # API key Pinecone, nếu dùng vector store cloud
# PINECONE_ENVIRONMENT=   # Region/environment của Pinecone index (vd: us-east-1-aws)

# ---- App Config ----
# Môi trường chạy: development | production | test
APP_ENV=development
# Cổng HTTP/WebSocket của FastAPI backend
APP_PORT=8000
# Địa chỉ bind của server (0.0.0.0 = nhận kết nối từ mọi interface, cần cho Docker)
APP_HOST=0.0.0.0
# Danh sách origin frontend được phép gọi API/WebSocket, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
# API key LangSmith để trace agent run (lấy tại smith.langchain.com)
LANGCHAIN_API_KEY=your-langsmith-key-here
# Tên project trên LangSmith mà trace sẽ được gom vào
LANGCHAIN_PROJECT=ai20k-agent
# Bật/tắt gửi trace lên LangSmith (true | false)
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
# Mức log của ứng dụng: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
# Endpoint grading server nhận AI usage log (giữ nguyên, do BTC cung cấp)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# Key riêng của đội — thay bằng key từ link mời của BTC (giá trị dưới chỉ là placeholder)
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
# Thư mục local chứa session.jsonl trước khi submit lên server
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000   # Base URL backend cho Next.js gọi REST/WebSocket
