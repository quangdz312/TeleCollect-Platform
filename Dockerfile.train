# Image chạy trên GPU thuê (RunPod Serverless) — KHÔNG phải image server.
#
# Tách hẳn khỏi `Dockerfile`: image này kéo torch bản CUDA nên nặng vài GB,
# trong khi server chỉ nhận dữ liệu và điều phối, không train.
#
# Build và đẩy lên Docker Hub:
#   docker build -f Dockerfile.train -t <tài-khoản>/telecollect-train:v3 .
#   docker push <tài-khoản>/telecollect-train:v3
#
# Đặt tag phiên bản, đừng dùng `latest`: RunPod cache image, `latest` khiến
# không biết endpoint đang chạy bản nào.

# CUDA 12.4 runtime khớp với bánh xe torch cu124 lấy ở dưới. Bản `runtime`
# (không phải `devel`) đủ để chạy: `devel` thêm trình biên dịch CUDA ~2 GB mà
# ta không dùng vì torch đã biên dịch sẵn.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # Image này kéo vài GB bánh xe; một lần đọc chậm không được làm đổ cả lần
    # build 20 phút. Đã gặp: `pip install --upgrade pip` chết vì ReadTimeout
    # tới files.pythonhosted.org dù máy build vẫn vào PyPI bình thường.
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

# python3.11: khớp bản của image server, tránh lệch hành vi giữa hai nơi.
# build-essential + linux-libc-dev: pynput kéo theo evdev, gói này không có
# bánh xe dựng sẵn và phải biên dịch phần mở rộng C từ linux/input*.h. Thiếu
# hai gói này thì `pip install -r requirements.txt` hỏng ngay từ đầu.
# cmake + make: robomimic kéo theo egl_probe, cũng biên dịch bằng C.
# ffmpeg, libgl1, libglib2.0-0: opencv-python-headless vẫn dlopen() chúng dù
# tên có chữ "headless"; ffmpeg dùng để ghi video rollout.
# libosmesa6: rollout lúc train cần dựng ngữ cảnh đồ họa mà máy thuê không có
# màn hình — OSMesa là backend duy nhất chạy được trong hoàn cảnh đó.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-venv python3-pip \
        git build-essential linux-libc-dev cmake make \
        ffmpeg libgl1 libglib2.0-0 libosmesa6 libglfw3 \
    && rm -rf /var/lib/apt/lists/*

# Venv chứ không phải `pip install --user`: gói cài theo --user nằm trong
# $HOME của đúng một user và chỉ user đó thấy trên sys.path. Site-packages của
# venv gắn với prefix của venv nên user nào kích hoạt cũng dùng được.
RUN python3.11 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install --upgrade pip

WORKDIR /app

# torch lấy từ index riêng của PyTorch, KHÔNG từ PyPI: PyPI trả bản CPU, cài
# xong `torch.cuda.is_available()` trả False và cả lần thuê GPU thành vô nghĩa.
# cu124 khớp với image CUDA 12.4 ở trên.
RUN pip install torch==2.6.0 torchvision==0.21.0 \
        --index-url https://download.pytorch.org/whl/cu124

# Cài dependency trước khi copy mã nguồn: sửa một dòng trong src/ thì Docker
# vẫn dùng lại được lớp cache này thay vì tải lại vài GB.
COPY requirements.txt .
RUN pip install -r requirements.txt

# robomimic 0.5 chỉ có trên GitHub (PyPI dừng ở 0.3.0). `--no-deps` để nó
# không kéo numpy lên 2.x — numba (qua dvc) và robosuite đều cần bản 1.x mà
# requirements.txt đã ghim.
#
# Nhưng `--no-deps` bỏ luôn cả phụ thuộc thật sự cần, nên phải cài tay:
# `robomimic/utils/file_utils.py` import `huggingface_hub` ngay ở đầu module,
# nên thiếu nó thì `from robomimic.scripts.train import train` hỏng và job
# thất bại với mã 1 trước cả epoch đầu tiên (đã gặp trên image v1).
# Danh sách này lấy từ phần hướng dẫn cài tay trong `requirements-train.txt`.
#
# Ghim phiên bản, và ghim đúng những con số đã đo được là chạy trên image v3.
# Trước đó để trống nên mỗi lần build ra một image khác nhau: chỉ ba ngày giữa
# v2 và v3, `transformers` đã nhảy 4.41 -> 5.16 và `huggingface_hub` 0.23 ->
# 1.29. Lần này vẫn chạy, nhưng đó là may chứ không phải thiết kế — và một
# image train hỏng chỉ lộ ra khi đang trả tiền GPU.
#
# robomimic 0.5 khai nó cần bản cũ hơn hẳn (huggingface_hub 0.23.4,
# transformers 4.41.2, diffusers 0.11.1). pip sẽ cảnh báo xung đột khi build.
# Giữ bản mới vì đã kiểm chứng `file_utils` và `robomimic.scripts.train` đều
# import được; hạ xuống đúng bản robomimic khai là việc khác, cần đo lại.
RUN pip install --no-deps \
        "robomimic @ git+https://github.com/ARISE-Initiative/robomimic.git@v0.5" \
    && pip install imageio==2.37.4 imageio-ffmpeg==0.6.0 tensorboard==2.21.0 \
        tensorboardX==2.6.5 matplotlib==3.11.1 \
    && pip install huggingface-hub==1.29.0 diffusers==0.40.0 \
        transformers==5.16.1 safetensors==0.8.0 \
    && pip install "numpy>=1.26.0,<2.0.0"

# SDK của RunPod và W&B: chỉ image này cần, nên không nằm trong requirements.txt.
# `wandb` đến từ PR #29 — image v1 dựng trước đó nên không có, bật W&B sẽ hỏng.
RUN pip install runpod==1.12.0 wandb==0.29.0

# Cùng lý do như image server — xem ghi chú ở `Dockerfile`. MUJOCO_GL chọn
# backend của MuJoCo, còn PyOpenGL có bộ dò nền riêng mặc định chọn GLX và
# phải báo riêng, nếu không `import mujoco` lỗi
# `AttributeError: 'GLXPlatform' object has no attribute 'OSMesa'`.
ENV MUJOCO_GL=osmesa
ENV PYOPENGL_PLATFORM=osmesa

# Chỉ copy thứ handler cần. `.dockerignore` đã loại data/, frontend/,
# local_app/ và tests/ khỏi build context.
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY runpod_handler.py ./

# Chạy bằng root: worker Serverless là container dùng một lần, không phục vụ
# cổng nào ra ngoài, và ghi vào /tmp lẫn thư mục cache của thư viện.
CMD ["python", "-u", "runpod_handler.py"]
