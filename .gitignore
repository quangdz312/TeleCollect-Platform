# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Office: file khoá tạm khi đang mở. `*~` ở trên không bắt được vì dấu nằm
# ở đầu tên, không phải cuối.
~$*

# Data — chặn payload, GIỮ con trỏ DVC (*.dvc, dvc.lock, .gitignore do DVC sinh)
/data/episodes/
/data/runs/
/data/*.db
/data/datasets/*/*/
*.db
*.sqlite3

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/
data/

# Local test and generated artifacts
/.test-*/
/.test-*.hdf5
/.test-*.hdf5.trace.jsonl
/pytest-cache-files-*/
/.mvp-audit-temp-*/
/.report-build/
.pytest_cache/
pytest-of-*/

# ML payloads outside the ignored data directory
*.hdf5
*.h5
*.pth
*.pt
*.ckpt
*.trace.jsonl

# Generated review and rollout media
*.mp4
*.avi
*.mkv

# Tool and model caches
*.tsbuildinfo
.cache/
huggingface/
wandb/

# Personal Codex configuration and automatic logging
/.codex/hooks.json
/.codex/config.toml
/scripts/log_hook.py
/.ai-log/

# Runtime artefacts — written while the app runs, not source
MUJOCO_LOG.TXT
frontend/.devserver*.log

# Written by `next dev` itself on every run
frontend/AGENTS.md
frontend/CLAUDE.md

# Regenerated by `next dev` and `next build`, and they disagree: dev points the
# references at .next/dev/types, build at .next/types. Tracking it means the file
# flips back and forth depending on which command ran last. Nobody needs the
# committed copy -- either command writes it before anything reads it.
frontend/next-env.d.ts

# Desktop app build output — the packaged Electron app, its unpacked bundles and
# installers together run to several GB. Git keeps history forever, so these can
# never be un-committed without rewriting it; only the source under local_app/
# belongs in the repo.
local_app/release/
local_app/release-*/
local_app/dist/
local_app/build/
local_app/package/
local_app/electron/node_modules/
local_app/electron/*.log
# Scratch workspaces written by the desktop backend while testing.
local_app/data-test/
local_app/data-desktop-test/
local_app/data-desktop-auth-test/

# Backups copied off the VPS before a deploy.
_vps-backups/

# Slide trình bày: bản nguồn giữ ở máy, không đưa lên repo.
*.pptx
