# Copy to .env.local for local web development.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Data is collected in the desktop app; the web only receives what was already
# collected. Leave this at 0 so the local web matches the deployed server —
# without it the flag defaults to on and the local web grows a Collect data
# screen production does not have.
#
# The packaged app is unaffected either way: local_app/web_shell.py builds the
# frontend with this set to "1" in the environment, and Next.js keeps an
# existing environment variable rather than overriding it from this file.
NEXT_PUBLIC_COLLECTION_ENABLED=0
