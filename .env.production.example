# TeleCollect P-111 — CPU-only staging production env.
# Copy to /srv/telecollect/secrets/.env.production on the VPS, fill in real
# values (chmod 600), and NEVER commit the filled-in file.
#
# Two kinds of variable here:
#   - Backend runtime: read by FastAPI at process start (src/config.py). A
#     plain restart picks up a change.
#   - Frontend build-time (NEXT_PUBLIC_*): baked into the Next.js bundle by
#     `next build` (see frontend/lib/api.ts, frontend/lib/real-teleop.ts).
#     Changing one requires rebuilding the frontend image, not just restarting
#     the container.

# ---------------------------------------------------------------------------
# Backend runtime (src/config.py)
# ---------------------------------------------------------------------------

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Generate with: openssl rand -hex 32
# Never reuse the value from local .env or from any other deployment.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Absolute path inside the backend container. docker-compose.prod.yml mounts
# the host data directory to /app/data — keep this path in sync with that
# mount, not with the host path.
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db
STORAGE_DIR=/app/data
REVIEW_DIR=/app/data/review

# Comma-separated list, no trailing slash. Must be the exact public origin
# BTC will open in the browser (see src/main.py CORSMiddleware).
CORS_ORIGINS=https://CHANGE_ME.io.vn

# Self-registration always creates role=operator (src/api/auth.py) and can
# never create the first admin. Before setting this to false, confirm
# `python -m scripts.create_admin` has already been run once against this
# database — otherwise there is no way to reach an admin account.
ALLOW_SELF_REGISTER=false

# Keep false so BTC can exercise the real reviewer/operator separation
# (a reviewer cannot approve their own upload). See src/api/demos.py.
ALLOW_SELF_REVIEW=false

MAX_UPLOAD_MB=200

# CPU staging has no GPU and the production image only installs
# requirements.txt (not requirements-train.txt / robomimic training deps).
# Keep this false until Phase GPU is scoped; see src/api/training.py
# _require_training_enabled() and src/config.py Settings.training_enabled.
TRAINING_ENABLED=false

# ---------------------------------------------------------------------------
# Frontend build-time (frontend/lib/api.ts, frontend/lib/real-teleop.ts)
# ---------------------------------------------------------------------------

# frontend/lib/api.ts prefers NEXT_PUBLIC_API_URL over NEXT_PUBLIC_API_ORIGIN
# if both are set; only one is needed. Same origin as CORS_ORIGINS above.
NEXT_PUBLIC_API_URL=https://CHANGE_ME.io.vn
NEXT_PUBLIC_API_ORIGIN=https://CHANGE_ME.io.vn

# frontend/lib/real-teleop.ts falls back to NEXT_PUBLIC_API_URL/ORIGIN with
# http->ws replaced if this is unset; set it explicitly for clarity.
NEXT_PUBLIC_WS_BASE=wss://CHANGE_ME.io.vn

# Mirrors TRAINING_ENABLED above so the Training page shows the "not
# available" message instead of calling an endpoint that will 403. This is
# baked in at build time, so keep it in sync with the backend flag by hand.
NEXT_PUBLIC_TRAINING_ENABLED=false

# ---------------------------------------------------------------------------
# docker-compose.prod.yml only (not read by the app itself)
# ---------------------------------------------------------------------------

# Host path bind-mounted to /app/data in the backend container. Must already
# exist and be owned by the same UID the backend container runs as.
DATA_HOST_PATH=/srv/telecollect/data

# Domain Caddy requests a certificate for. No scheme, no trailing slash.
PROJECT_DOMAIN=CHANGE_ME.io.vn

# Email Let's Encrypt uses for expiry/problem notices about the certificate.
ACME_EMAIL=CHANGE_ME@example.com
